# Required: your Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional
PORT=3000          # plain HTTP (camera works on http://localhost only)
HTTPS_PORT=3443    # self-signed HTTPS for other computers on your network
GEMINI_MODEL=gemini-3.5-live-translate-preview

# Optional TURN server (needed when peers are behind strict NATs / different networks)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
